NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Set to "true" to register the service worker in development (off by default).
NEXT_PUBLIC_SW_DEV=false

# Public origin of the site — used for canonical URLs, hreflang, sitemap, Open Graph and JSON-LD.
NEXT_PUBLIC_SITE_URL=http://localhost:3020
# Server-side only: where SSR/route handlers reach the API (inside Docker: http://backend:5000/api).
# Leave unset to use NEXT_PUBLIC_API_URL everywhere.
# API_INTERNAL_URL=
