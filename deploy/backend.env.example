# backend/.env for PRODUCTION (copy to ../backend/.env on the server, fill every CHANGE_ME).
# DATABASE_URL, REDIS_URL, CORS_ORIGIN and FRONTEND_URL are injected by docker-compose.prod.yml
# from the root .env — they are listed here only so the file is complete when read outside Docker.

NODE_ENV=production
PORT=5000
LOG_LEVEL=info
LOG_PRETTY=false

# Injected by compose (kept for reference)
# DATABASE_URL=postgresql://smartmarket:...@host.docker.internal:5432/smart_market?schema=public
# REDIS_URL=redis://redis:6379
# CORS_ORIGIN=https://smartmarket.example
# FRONTEND_URL=https://smartmarket.example
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECT_TIMEOUT_MS=5000

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=CHANGE_ME
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_SALT_ROUNDS=12
# Leave COOKIE_DOMAIN unset: site and API share one origin behind Caddy.

# Cloudflare R2 (images)
CLOUDFLARE_R2_ACCOUNT_ID=CHANGE_ME
CLOUDFLARE_R2_ACCESS_KEY_ID=CHANGE_ME
CLOUDFLARE_R2_SECRET_ACCESS_KEY=CHANGE_ME
CLOUDFLARE_R2_BUCKET_NAME=CHANGE_ME
CLOUDFLARE_R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# K-Pay (Mobile Money). Register the webhook URL in the K-Pay dashboard as:
#   https://<DOMAIN>/api/payments/webhooks/kpay
KPAY_API_KEY=CHANGE_ME
KPAY_SECRET_KEY=CHANGE_ME
KPAY_WEBHOOK_SECRET=CHANGE_ME
KPAY_GATEWAY_SECRET=CHANGE_ME
KPAY_BASE_URL=https://admin.kpay.site/api/v1
PAYMENT_EXPIRY_HOURS=2

# Resend (transactional email) — the sender domain must be verified in Resend.
RESEND_API_KEY=CHANGE_ME
RESEND_FROM_EMAIL="Smart Market <no-reply@smartmarket.example>"
SUPPORT_EMAIL=support@smartmarket.example
OTP_EMAIL_VERIFICATION_TTL_MIN=10
OTP_PASSWORD_RESET_TTL_MIN=15

# Google OAuth — add this exact redirect URI in Google Cloud Console:
#   https://<DOMAIN>/api/auth/google/callback
GOOGLE_CLIENT_ID=CHANGE_ME
GOOGLE_CLIENT_SECRET=CHANGE_ME
GOOGLE_REDIRECT_URI=https://smartmarket.example/api/auth/google/callback

# Claude shopping assistant (leave empty to keep it offline)
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-opus-5
ASSISTANT_MAX_TOOL_TURNS=4

# Observability
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# Background jobs + rate limits
JOBS_ENABLED=true
AUDIT_LOG_RETENTION_DAYS=365
GENERAL_RATE_LIMIT_PER_MINUTE=120
