# Root .env for docker compose on the server (copy to ../.env). Read by compose only.

# The public hostname — DNS A/AAAA records for DOMAIN and www.DOMAIN must point at this server
# BEFORE the first `up`, or Caddy cannot obtain the certificate.
DOMAIN=smartmarket.example
ACME_EMAIL=admin@smartmarket.example

# Backend container → Postgres on the host. Create a dedicated role, never use the superuser.
DOCKER_DATABASE_URL="postgresql://smartmarket:CHANGE_ME@host.docker.internal:5432/smart_market?schema=public"
