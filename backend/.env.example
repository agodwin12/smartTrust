NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:3020
FRONTEND_URL=http://localhost:3020

# Local PostgreSQL — update user/password/db name to match your local setup
DATABASE_URL="postgresql://postgres:password@localhost:5432/smart_market?schema=public"
# Pool size per app instance — total across all instances must stay under Postgres's max_connections
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECT_TIMEOUT_MS=5000

# Auth — generate your own secret, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_SALT_ROUNDS=12
# COOKIE_DOMAIN=.smartmarket.com   # only needed once frontend/backend share a parent domain in prod

# Cloudflare R2 (S3-compatible) — ask for the real values, they're not committed
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=
CLOUDFLARE_R2_PUBLIC_URL=

# K-Pay (Mobile Money / Orange Money) — ask for the real values, they're not committed
KPAY_API_KEY=
KPAY_SECRET_KEY=
KPAY_WEBHOOK_SECRET=
KPAY_GATEWAY_SECRET=
KPAY_BASE_URL=https://admin.kpay.site/api/v1

# Redis (caching + distributed rate limiting) — "redis" is the docker-compose service
# name; use redis://localhost:6379 for local dev without Docker
REDIS_URL=redis://redis:6379

# Resend (email) — ask for the real API key, it's not committed
RESEND_API_KEY=
RESEND_FROM_EMAIL="Smart Market <onboarding@resend.dev>"
OTP_EMAIL_VERIFICATION_TTL_MIN=10
OTP_PASSWORD_RESET_TTL_MIN=15

# Google OAuth — create credentials in Google Cloud Console; GOOGLE_REDIRECT_URI must be
# registered there as an exact "Authorized redirect URI"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# Claude shopping assistant (Anthropic API) — ask for the real key, it's not committed.
# Leave empty to keep the assistant offline (the widget shows its shortcut chips instead).
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-opus-5
ASSISTANT_MAX_TOOL_TURNS=4

# Observability — structured JSON logs (pino). LOG_LEVEL: fatal|error|warn|info|debug|trace.
LOG_LEVEL=info
# LOG_PRETTY=false            # pretty-print in development (default on outside production)
# Error tracking — leave SENTRY_DSN empty to disable Sentry entirely.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# Background jobs (subscription expiry, stale payments, payout polling, audit retention)
JOBS_ENABLED=true
AUDIT_LOG_RETENTION_DAYS=365
PAYMENT_EXPIRY_HOURS=2

# Baseline API rate limit per IP per minute (endpoint-specific limits still apply on top)
GENERAL_RATE_LIMIT_PER_MINUTE=120
