# Read by docker-compose (NOT by the backend/frontend apps themselves — they have
# their own .env files). Only needed when running `docker compose up`.

# The backend container's connection to your LOCAL Postgres — same DB the
# non-containerized backend uses, just addressed via host.docker.internal instead
# of localhost (inside a container, "localhost" means the container itself).
DOCKER_DATABASE_URL="postgresql://postgres:your-local-postgres-password@host.docker.internal:5432/smart_market?schema=public"
